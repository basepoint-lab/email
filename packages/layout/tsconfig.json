{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@basepoint-lab/tokens": ["../tokens/dist/index.d.ts"],
      "@basepoint-lab/ui": ["../ui/dist/index.d.ts"],
      "react": ["../../portal/node_modules/@types/react"],
      "react/jsx-runtime": ["../../portal/node_modules/@types/react/jsx-runtime"],
      "react-dom": ["../../portal/node_modules/@types/react-dom"],
      "lucide-react": ["../../portal/node_modules/lucide-react"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
