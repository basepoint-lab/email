{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@basepoint-lab/tokens": ["./packages/tokens/src/index.ts"],
      "@basepoint-lab/tokens/*": ["./packages/tokens/src/*"],
      "@basepoint-lab/ui": ["./packages/ui/src/index.ts"],
      "@basepoint-lab/ui/*": ["./packages/ui/src/*"],
      "@basepoint-lab/layout": ["./packages/layout/src/index.ts"],
      "@basepoint-lab/layout/*": ["./packages/layout/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "packages/**/tests/**",
    "packages/**/tsup.config.ts"
  ]
}
